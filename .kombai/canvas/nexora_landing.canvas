      "html": "\n<div class=\"bg-[#F7F7F7] text-[#111111] font-['Be_Vietnam_Pro'] selection:bg-[#FF4F00]/20 selection:text-[#111111]\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Be+Vietnam+Pro:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .font-heading { font-family: 'Instrument Sans', sans-serif; }\n    .font-body { font-family: 'Be Vietnam Pro', sans-serif; }\n\n    .glass-nav {\n      background: rgba(247, 247, 247, 0.8);\n      backdrop-filter: blur(12px);\n    }\n\n    .hairline-border {\n      border: 1px solid #d0d0cc;\n    }\n\n    .subtle-shadow {\n      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.01), 0 2px 4px -1px rgba(0, 0, 0, 0.005);\n    }\n\n    .premium-shadow {\n      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.02), 0 10px 10px -5px rgba(0, 0, 0, 0.01);\n    }\n\n    .hero-gradient-text {\n      background: linear-gradient(135deg, #111111 30%, #FF4F00 100%);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n    }\n\n    @keyframes float {\n      0% { transform: translateY(0px); }\n      50% { transform: translateY(-10px); }\n      100% { transform: translateY(0px); }\n    }\n    .animate-float { animation: float 6s ease-in-out infinite; }\n\n    .dot-pattern {\n      background-image: radial-gradient(rgba(255, 79, 0, 0.08) 1px, transparent 1px);\n      background-size: 24px 24px;\n    }\n\n    .kanban-col {\n      min-height: 400px;\n    }\n\n    .orange-glow {\n      box-shadow: 0 0 40px 0 rgba(255, 79, 0, 0.1);\n    }\n  </style>\n\n  \n  <nav class=\"sticky top-0 z-[100] glass-nav border-b border-[#d0d0cc]/50 py-4 px-8\" data-kid=\"2\">\n    <div class=\"max-w-7xl mx-auto flex items-center justify-between\" data-kid=\"3\">\n      <div class=\"flex items-center gap-10\" data-kid=\"4\">\n        <div class=\"flex items-center gap-2 group cursor-pointer\" data-kid=\"5\">\n          <div class=\"w-9 h-9 bg-[#FF4F00] rounded-lg flex items-center justify-center transform group-hover:rotate-6 transition-transform\" data-kid=\"6\">\n            <span class=\"text-white font-bold text-xl font-heading leading-none\" data-kid=\"7\">N</span>\n          </div>\n          <span class=\"text-xl font-heading font-bold tracking-tight text-[#111111]\" data-kid=\"8\">Nexora</span>\n        </div>\n        \n        <div class=\"hidden lg:flex items-center gap-6 text-[13px] font-semibold text-slate-500\" data-kid=\"9\">\n          <a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"10\">Opportunities</a>\n          <a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"11\">Scholarships</a>\n          <a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"12\">Fellowships</a>\n          <a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"13\">Grants</a>\n          <a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"14\">Accelerators</a>\n          <a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"15\">Competitions</a>\n          <a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"16\">Resources</a>\n        </div>\n      </div>\n\n      <div class=\"flex items-center gap-4\" data-kid=\"17\">\n        <button class=\"text-sm font-bold text-slate-600 hover:text-[#FF4F00] transition-colors px-4 py-2\" data-kid=\"18\">Login</button>\n        <button class=\"bg-[#FF4F00] text-white text-sm font-bold px-6 py-2.5 rounded-full hover:bg-[#e64600] transition-all shadow-sm hover:shadow-[#FF4F00]/20\" data-kid=\"19\">\n          Get Started\n        </button>\n      </div>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative pt-24 pb-32 px-8 overflow-hidden\" data-kid=\"20\">\n    <div class=\"absolute inset-0 dot-pattern -z-10 opacity-60\" data-kid=\"21\"></div>\n    <div class=\"max-w-5xl mx-auto text-center relative\" data-kid=\"22\">\n      <div class=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#FF4F00]/5 border border-[#FF4F00]/10 text-[11px] font-bold text-[#FF4F00] mb-8 uppercase tracking-[0.15em]\" data-kid=\"23\">\n        <span class=\"w-2 h-2 rounded-full bg-[#FF4F00] animate-pulse\" data-kid=\"24\"></span>\n        AI-Powered Discovery Engine\n      </div>\n      \n      <h1 class=\"text-6xl md:text-8xl font-heading font-bold text-[#111111] tracking-tight leading-[0.95] mb-8\" data-kid=\"25\">\n        The World's Opportunity <br data-kid=\"26\">\n        <span class=\"hero-gradient-text\" data-kid=\"27\">Intelligence Network</span>\n      </h1>\n\n      <p class=\"text-lg md:text-xl text-slate-500 max-w-2xl mx-auto mb-12 leading-relaxed font-light\" data-kid=\"28\">\n        Discover scholarships, fellowships, grants, accelerators, competitions, research programs, and career opportunities from around the world—all personalized by AI.\n      </p>\n\n      \n      <div class=\"max-w-2xl mx-auto mb-12 group\" data-kid=\"29\">\n        <div class=\"relative flex items-center p-2 bg-white hairline-border rounded-2xl shadow-xl shadow-slate-200/40 focus-within:border-[#FF4F00] transition-all\" data-kid=\"30\">\n          <i class=\"ti ti-search text-slate-400 ml-4 text-xl\" data-kid=\"31\"></i>\n          <input type=\"text\" placeholder=\"I'm a Computer Science student from India looking for AI research opportunities...\" class=\"w-full bg-transparent border-none outline-hidden px-4 py-4 text-sm text-[#111111] placeholder:text-slate-400\" data-kid=\"32\">\n          <button class=\"hidden md:block bg-[#FF4F00] text-white px-8 py-4 rounded-xl font-bold text-sm hover:bg-[#e64600] transition-all\" data-kid=\"33\">\n            Discover\n          </button>\n        </div>\n        <div class=\"flex flex-wrap justify-center gap-x-6 gap-y-2 mt-6\" data-kid=\"34\">\n          <span class=\"text-[10px] font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"35\">Trending:</span>\n          <a href=\"#\" class=\"text-[11px] font-semibold text-slate-500 hover:text-[#FF4F00] transition-colors\" data-kid=\"36\">AI Research</a>\n          <a href=\"#\" class=\"text-[11px] font-semibold text-slate-500 hover:text-[#FF4F00] transition-colors\" data-kid=\"37\">Scholarships</a>\n          <a href=\"#\" class=\"text-[11px] font-semibold text-slate-500 hover:text-[#FF4F00] transition-colors\" data-kid=\"38\">Startup Grants</a>\n          <a href=\"#\" class=\"text-[11px] font-semibold text-slate-500 hover:text-[#FF4F00] transition-colors\" data-kid=\"39\">Accelerators</a>\n        </div>\n      </div>\n\n      \n      <div class=\"relative h-[480px] mt-20 max-w-4xl mx-auto\" data-kid=\"40\">\n        <div class=\"absolute inset-0 bg-white/40 hairline-border rounded-[40px] shadow-2xl backdrop-blur-sm -z-10\" data-kid=\"41\"></div>\n        \n        \n        <div class=\"absolute top-10 -left-12 w-72 bg-white p-6 rounded-2xl hairline-border shadow-2xl animate-float\" style=\"animation-delay: 0s\" data-kid=\"42\">\n          <div class=\"flex justify-between items-start mb-4\" data-kid=\"43\">\n            <div class=\"w-10 h-10 bg-blue-50 rounded-lg flex items-center justify-center\" data-kid=\"44\">\n              <i class=\"ti ti-microscope text-blue-600 text-xl\" data-kid=\"45\"></i>\n            </div>\n            <div class=\"bg-emerald-50 text-emerald-600 px-3 py-1 rounded-full text-[10px] font-bold\" data-kid=\"46\">94% MATCH</div>\n          </div>\n          <h4 class=\"font-bold text-sm text-[#111111] mb-1 text-left\" data-kid=\"47\">Google Research Fellowship</h4>\n          <p class=\"text-[11px] text-slate-500 text-left mb-4\" data-kid=\"48\">Mountain View • AI Research</p>\n          <div class=\"flex justify-between items-center pt-4 border-t border-slate-50\" data-kid=\"49\">\n            <span class=\"text-xs font-bold text-[#111111]\" data-kid=\"50\">$10,000 Funding</span>\n            <span class=\"text-[10px] font-bold text-[#FF4F00] uppercase\" data-kid=\"51\">12 Days Left</span>\n          </div>\n        </div>\n\n        \n        <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 bg-white p-7 rounded-3xl hairline-border shadow-[0_32px_64px_-16px_rgba(0,0,0,0.1)] z-20\" data-kid=\"52\">\n          <div class=\"flex justify-between items-start mb-5\" data-kid=\"53\">\n            <div class=\"w-12 h-12 bg-orange-50 rounded-xl flex items-center justify-center text-[#FF4F00] font-black text-xl\" data-kid=\"54\">YC</div>\n            <div class=\"bg-emerald-50 text-emerald-600 px-3 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase\" data-kid=\"55\">91% MATCH</div>\n          </div>\n          <h4 class=\"font-bold text-base text-[#111111] mb-2 text-left leading-tight\" data-kid=\"56\">Y Combinator Startup School</h4>\n          <p class=\"text-xs text-slate-500 text-left mb-6\" data-kid=\"57\">Global • Founder Program</p>\n          <div class=\"flex items-center gap-2 mb-6\" data-kid=\"58\">\n            <div class=\"flex -space-x-2\" data-kid=\"59\">\n              <img src=\"https://i.pravatar.cc/100?u=1\" class=\"w-6 h-6 rounded-full border-2 border-white\" decoding=\"async\" loading=\"lazy\" data-kid=\"60\">\n              <img src=\"https://i.pravatar.cc/100?u=2\" class=\"w-6 h-6 rounded-full border-2 border-white\" decoding=\"async\" loading=\"lazy\" data-kid=\"61\">\n              <img src=\"https://i.pravatar.cc/100?u=3\" class=\"w-6 h-6 rounded-full border-2 border-white\" decoding=\"async\" loading=\"lazy\" data-kid=\"62\">\n            </div>\n            <span class=\"text-[10px] font-bold text-slate-400\" data-kid=\"63\">12k+ Founders applying</span>\n          </div>\n          <button class=\"w-full bg-[#111111] text-white py-3 rounded-xl text-xs font-bold hover:bg-slate-800 transition-colors\" data-kid=\"64\">\n            Apply Now\n          </button>\n        </div>\n\n        \n        <div class=\"absolute bottom-10 -right-12 w-72 bg-white p-6 rounded-2xl hairline-border shadow-2xl animate-float\" style=\"animation-delay: 2s\" data-kid=\"65\">\n          <div class=\"flex justify-between items-start mb-4\" data-kid=\"66\">\n            <div class=\"w-10 h-10 bg-purple-50 rounded-lg flex items-center justify-center text-purple-600\" data-kid=\"67\">\n               <i class=\"ti ti-cap-straight text-xl\" data-kid=\"68\"></i>\n            </div>\n            <div class=\"bg-emerald-50 text-emerald-600 px-3 py-1 rounded-full text-[10px] font-bold\" data-kid=\"69\">89% MATCH</div>\n          </div>\n          <h4 class=\"font-bold text-sm text-[#111111] mb-1 text-left\" data-kid=\"70\">Women in AI Scholarship</h4>\n          <p class=\"text-[11px] text-slate-500 text-left mb-4\" data-kid=\"71\">Fully Funded • Europe</p>\n          <div class=\"flex justify-between items-center pt-4 border-t border-slate-50\" data-kid=\"72\">\n            <span class=\"text-xs font-bold text-[#111111]\" data-kid=\"73\">Full Tuition</span>\n            <span class=\"text-[10px] font-bold text-[#FF4F00] uppercase\" data-kid=\"74\">Ends Tomorrow</span>\n          </div>\n        </div>\n\n        \n        <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#FF4F00]/5 blur-[120px] rounded-full -z-20\" data-kid=\"75\"></div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-20 border-y border-[#d0d0cc]/50 bg-white\" data-kid=\"76\">\n    <div class=\"max-w-7xl mx-auto px-8\" data-kid=\"77\">\n      <p class=\"text-center text-[10px] font-black text-slate-400 uppercase tracking-[0.4em] mb-12\" data-kid=\"78\">Trusted by ambitious talent worldwide</p>\n      <div class=\"grid grid-cols-2 md:grid-cols-4 gap-12\" data-kid=\"79\">\n        <div class=\"text-center\" data-kid=\"80\">\n          <p class=\"text-4xl md:text-5xl font-heading font-bold text-[#111111] mb-2 tracking-tighter\" data-kid=\"81\">100K+</p>\n          <p class=\"text-[11px] font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"82\">Active Users</p>\n        </div>\n        <div class=\"text-center\" data-kid=\"83\">\n          <p class=\"text-4xl md:text-5xl font-heading font-bold text-[#111111] mb-2 tracking-tighter\" data-kid=\"84\">500K+</p>\n          <p class=\"text-[11px] font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"85\">Opportunities Indexed</p>\n        </div>\n        <div class=\"text-center\" data-kid=\"86\">\n          <p class=\"text-4xl md:text-5xl font-heading font-bold text-[#111111] mb-2 tracking-tighter\" data-kid=\"87\">190+</p>\n          <p class=\"text-[11px] font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"88\">Countries</p>\n        </div>\n        <div class=\"text-center\" data-kid=\"89\">\n          <p class=\"text-4xl md:text-5xl font-heading font-bold text-[#111111] mb-2 tracking-tighter\" data-kid=\"90\">10M+</p>\n          <p class=\"text-[11px] font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"91\">AI Matches</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-8\" data-kid=\"92\">\n    <div class=\"max-w-6xl mx-auto\" data-kid=\"93\">\n      <div class=\"text-center mb-20\" data-kid=\"94\">\n        <h2 class=\"text-4xl md:text-5xl font-heading font-bold text-[#111111] mb-6 tracking-tight\" data-kid=\"95\">Why Great Opportunities Go Unnoticed</h2>\n        <p class=\"text-lg text-slate-500 max-w-xl mx-auto font-light\" data-kid=\"96\">The traditional discovery process is outdated, fragmented, and broken. We built the engine to fix it.</p>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\" data-kid=\"97\">\n        <div class=\"bg-white p-10 rounded-[32px] hairline-border hover:border-[#FF4F00] hover:shadow-2xl hover:shadow-[#FF4F00]/5 transition-all group\" data-kid=\"98\">\n          <div class=\"w-12 h-12 bg-slate-50 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-[#FF4F00]/10 transition-colors\" data-kid=\"99\">\n            <i class=\"ti ti-binary text-[#FF4F00] text-xl\" data-kid=\"100\"></i>\n          </div>\n          <h3 class=\"font-bold text-xl mb-4 text-[#111111]\" data-kid=\"101\">Fragmented Info</h3>\n          <p class=\"text-sm text-slate-500 leading-relaxed font-light\" data-kid=\"102\">Opportunities exist across thousands of isolated websites, government portals, and hidden databases.</p>\n        </div>\n\n        <div class=\"bg-white p-10 rounded-[32px] hairline-border hover:border-[#FF4F00] hover:shadow-2xl hover:shadow-[#FF4F00]/5 transition-all group\" data-kid=\"103\">\n          <div class=\"w-12 h-12 bg-slate-50 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-[#FF4F00]/10 transition-colors\" data-kid=\"104\">\n            <i class=\"ti ti-hourglass-low text-[#FF4F00] text-xl\" data-kid=\"105\"></i>\n          </div>\n          <h3 class=\"font-bold text-xl mb-4 text-[#111111]\" data-kid=\"106\">Missed Deadlines</h3>\n          <p class=\"text-sm text-slate-500 leading-relaxed font-light\" data-kid=\"107\">Important programs often close their applications before the right candidates even discover they exist.</p>\n        </div>\n\n        <div class=\"bg-white p-10 rounded-[32px] hairline-border hover:border-[#FF4F00] hover:shadow-2xl hover:shadow-[#FF4F00]/5 transition-all group\" data-kid=\"108\">\n          <div class=\"w-12 h-12 bg-slate-50 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-[#FF4F00]/10 transition-colors\" data-kid=\"109\">\n            <i class=\"ti ti-search text-[#FF4F00] text-xl\" data-kid=\"110\"></i>\n          </div>\n          <h3 class=\"font-bold text-xl mb-4 text-[#111111]\" data-kid=\"111\">Poor Search</h3>\n          <p class=\"text-sm text-slate-500 leading-relaxed font-light\" data-kid=\"112\">Traditional search engines don't understand your personal context, goals, or eligibility requirements.</p>\n        </div>\n\n        <div class=\"bg-white p-10 rounded-[32px] hairline-border hover:border-[#FF4F00] hover:shadow-2xl hover:shadow-[#FF4F00]/5 transition-all group\" data-kid=\"113\">\n          <div class=\"w-12 h-12 bg-slate-50 rounded-2xl flex items-center justify-center mb-8 group-hover:bg-[#FF4F00]/10 transition-colors\" data-kid=\"114\">\n            <i class=\"ti ti-layers-intersect text-[#FF4F00] text-xl\" data-kid=\"115\"></i>\n          </div>\n          <h3 class=\"font-bold text-xl mb-4 text-[#111111]\" data-kid=\"116\">Application Chaos</h3>\n          <p class=\"text-sm text-slate-500 leading-relaxed font-light\" data-kid=\"117\">Managing life-changing opportunities shouldn't happen in messy spreadsheets and browser tabs.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 bg-white px-8\" data-kid=\"118\">\n    <div class=\"max-w-6xl mx-auto\" data-kid=\"119\">\n      <div class=\"text-center mb-20\" data-kid=\"120\">\n        <h2 class=\"text-4xl md:text-5xl font-heading font-bold text-[#111111] mb-6 tracking-tight\" data-kid=\"121\">How Nexora Works</h2>\n        <p class=\"text-lg text-slate-500 max-w-xl mx-auto font-light\" data-kid=\"122\">The machinery behind global opportunity intelligence, simplified into six steps.</p>\n      </div>\n\n      <div class=\"relative\" data-kid=\"123\">\n        <div class=\"absolute top-[45px] left-0 w-full h-px bg-slate-100 hidden lg:block -z-10\" data-kid=\"124\"></div>\n        <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-12 relative z-10\" data-kid=\"125\">\n          <div class=\"text-center group\" data-kid=\"126\">\n            <div class=\"w-20 h-20 bg-white border-2 border-[#FF4F00] rounded-full flex items-center justify-center mx-auto mb-8 shadow-xl shadow-[#FF4F00]/10 transition-transform group-hover:scale-110\" data-kid=\"127\">\n              <span class=\"text-2xl font-bold text-[#FF4F00]\" data-kid=\"128\">01</span>\n            </div>\n            <h4 class=\"font-bold text-[#111111] mb-3\" data-kid=\"129\">AI Discovery</h4>\n            <p class=\"text-xs text-slate-500 leading-relaxed px-4\" data-kid=\"130\">Scans universities, governments, NGOs, and grant sites.</p>\n          </div>\n          <div class=\"text-center group\" data-kid=\"131\">\n            <div class=\"w-20 h-20 bg-white border-2 border-[#FF4F00] rounded-full flex items-center justify-center mx-auto mb-8 shadow-xl shadow-[#FF4F00]/10 transition-transform group-hover:scale-110\" data-kid=\"132\">\n              <span class=\"text-2xl font-bold text-[#FF4F00]\" data-kid=\"133\">02</span>\n            </div>\n            <h4 class=\"font-bold text-[#111111] mb-3\" data-kid=\"134\">Data Intel</h4>\n            <p class=\"text-xs text-slate-500 leading-relaxed px-4\" data-kid=\"135\">Extracts deadlines, eligibility, funding and requirements.</p>\n          </div>\n          <div class=\"text-center group\" data-kid=\"136\">\n            <div class=\"w-20 h-20 bg-white border-2 border-[#FF4F00] rounded-full flex items-center justify-center mx-auto mb-8 shadow-xl shadow-[#FF4F00]/10 transition-transform group-hover:scale-110\" data-kid=\"137\">\n              <span class=\"text-2xl font-bold text-[#FF4F00]\" data-kid=\"138\">03</span>\n            </div>\n            <h4 class=\"font-bold text-[#111111] mb-3\" data-kid=\"139\">Opp Graph</h4>\n            <p class=\"text-xs text-slate-500 leading-relaxed px-4\" data-kid=\"140\">Transforms raw web data into structured opportunities.</p>\n          </div>\n          <div class=\"text-center group\" data-kid=\"141\">\n            <div class=\"w-20 h-20 bg-white border-2 border-[#FF4F00] rounded-full flex items-center justify-center mx-auto mb-8 shadow-xl shadow-[#FF4F00]/10 transition-transform group-hover:scale-110\" data-kid=\"