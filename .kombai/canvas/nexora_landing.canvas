      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Be+Vietnam+Pro:wght@300;400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    padding: 0;\n    font-family: 'Be+Vietnam+Pro', sans-serif;\n    background-color: #F7F7F7;\n    color: #111111;\n  }\n\n  .font-heading {\n    font-family: 'Instrument Sans', sans-serif;\n  }\n\n  .hairline-border {\n    border: 1px solid #d0d0cc;\n  }\n\n  .simple-elevation {\n    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 10px 15px -3px rgba(0, 0, 0, 0.03);\n  }\n\n  /* Custom Dotted Background for Map */\n  .dot-pattern {\n    background-image: radial-gradient(#111111 1px, transparent 1px);\n    background-size: 24px 24px;\n  }\n</style>\n\n<div class=\"bg-[#F7F7F7]\" data-kid=\"1\">\n  \n  \n  <nav class=\"flex justify-between items-center px-12 py-8 bg-transparent\" data-kid=\"2\">\n    <div class=\"flex items-center gap-2\" data-kid=\"3\">\n      <div class=\"w-8 h-8 bg-[#FF4F00] rounded-sm flex items-center justify-center\" data-kid=\"4\">\n        <span class=\"text-white font-bold text-lg\" data-kid=\"5\">N</span>\n      </div>\n      <span class=\"text-xl font-bold tracking-tight font-heading\" data-kid=\"6\">Nexora</span>\n    </div>\n    <div class=\"hidden md:flex items-center gap-10 text-sm font-medium text-[#111111]/60\" data-kid=\"7\">\n      <a href=\"#\" class=\"hover:text-[#111111] transition-colors\" data-kid=\"8\">Intelligence</a>\n      <a href=\"#\" class=\"hover:text-[#111111] transition-colors\" data-kid=\"9\">Ecosystem</a>\n      <a href=\"#\" class=\"hover:text-[#111111] transition-colors\" data-kid=\"10\">Pricing</a>\n      <a href=\"#\" class=\"px-6 py-2.5 bg-white text-[#111111] rounded-full hairline-border hover:bg-gray-50 transition-all font-semibold\" data-kid=\"11\">Sign in</a>\n    </div>\n  </nav>\n\n  \n  <section class=\"py-32 px-8 flex flex-col items-center text-center\" data-kid=\"12\">\n    <div class=\"max-w-4xl\" data-kid=\"13\">\n      <h1 class=\"text-7xl md:text-8xl font-bold tracking-tighter text-[#111111] font-heading leading-[1.05]\" data-kid=\"14\">\n        Navigate Your <span class=\"relative inline-block\" data-kid=\"15\">\n          <span class=\"relative z-10 text-[#FF4F00]\" data-kid=\"16\">Future.</span>\n          <span class=\"absolute bottom-4 left-0 w-full h-4 bg-[#FF4F00]/10 -z-0\" data-kid=\"17\"></span>\n        </span>\n      </h1>\n      <p class=\"mt-10 text-xl md:text-2xl text-[#111111]/60 max-w-2xl mx-auto font-light leading-relaxed\" data-kid=\"18\">\n        AI-powered global opportunity intelligence. We fragment data to find your personalized path to excellence.\n      </p>\n      <div class=\"mt-12 flex flex-col sm:flex-row gap-5 justify-center\" data-kid=\"19\">\n        <button class=\"px-10 py-5 bg-[#FF4F00] text-white font-semibold rounded-full hover:bg-[#E64600] transition-all transform hover:scale-105 shadow-xl shadow-[#FF4F00]/20\" data-kid=\"20\">\n          Start discovering\n        </button>\n        <button class=\"px-10 py-5 bg-white text-[#111111] font-semibold rounded-full hairline-border hover:bg-gray-50 transition-all\" data-kid=\"21\">\n          Watch demo\n        </button>\n      </div>\n    </div>\n\n    \n    <div class=\"w-full max-w-6xl mt-24\" data-kid=\"22\">\n      <p class=\"text-[10px] font-bold tracking-[0.4em] text-[#111111]/25 uppercase mb-10\" data-kid=\"23\">Empowering the world's leading institutions</p>\n      <div class=\"flex flex-wrap justify-between items-center gap-x-16 gap-y-10 opacity-30 grayscale saturate-0 px-8\" data-kid=\"24\">\n        <span class=\"text-2xl font-bold font-serif tracking-tighter\" data-kid=\"25\">HARVARD</span>\n        <span class=\"text-2xl font-bold font-serif tracking-tighter\" data-kid=\"26\">STANFORD</span>\n        <span class=\"text-3xl font-bold font-heading\" data-kid=\"27\">SEQUOIA</span>\n        <span class=\"text-2xl font-bold font-heading\" data-kid=\"28\">Y Combinator</span>\n        <span class=\"text-2xl font-bold font-serif tracking-tighter\" data-kid=\"29\">OXFORD</span>\n        <span class=\"text-3xl font-bold font-heading tracking-tight\" data-kid=\"30\">a16z</span>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-8 relative overflow-hidden bg-white\" data-kid=\"31\">\n    <div class=\"max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-20 items-center\" data-kid=\"32\">\n      <div class=\"z-10\" data-kid=\"33\">\n        <h2 class=\"text-5xl font-bold text-[#111111] font-heading mb-8 leading-tight\" data-kid=\"34\">A Unified Map of<br data-kid=\"35\">Global Potential</h2>\n        <p class=\"text-lg text-[#111111]/60 font-light leading-relaxed mb-10 max-w-md\" data-kid=\"36\">\n          Nexora visualizes connections between fragmented opportunities, institutional trends, and human potential in real-time.\n        </p>\n        <div class=\"space-y-6\" data-kid=\"37\">\n          <div class=\"flex items-center gap-4\" data-kid=\"38\">\n            <div class=\"w-12 h-12 rounded-full bg-[#FF4F00]/5 flex items-center justify-center text-[#FF4F00]\" data-kid=\"39\">\n              <i class=\"ti ti-briefcase text-2xl\" data-kid=\"40\"></i>\n            </div>\n            <div data-kid=\"41\">\n              <p class=\"font-bold\" data-kid=\"42\">Career Intelligence</p>\n              <p class=\"text-sm text-[#111111]/50\" data-kid=\"43\">Hidden roles at top-tier startups</p>\n            </div>\n          </div>\n          <div class=\"flex items-center gap-4\" data-kid=\"44\">\n            <div class=\"w-12 h-12 rounded-full bg-[#FF4F00]/5 flex items-center justify-center text-[#FF4F00]\" data-kid=\"45\">\n              <i class=\"ti ti-school text-2xl\" data-kid=\"46\"></i>\n            </div>\n            <div data-kid=\"47\">\n              <p class=\"font-bold\" data-kid=\"48\">Academic Scouting</p>\n              <p class=\"text-sm text-[#111111]/50\" data-kid=\"49\">Unpublished research fellowships</p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"relative h-[600px] bg-[#F7F7F7] rounded-[32px] hairline-border overflow-hidden group shadow-inner\" data-kid=\"50\">\n        <div class=\"absolute inset-0 dot-pattern opacity-[0.07]\" data-kid=\"51\"></div>\n        \n        \n        <svg class=\"absolute inset-0 w-full h-full text-[#111111]/[0.02]\" viewBox=\"0 0 1000 500\" data-kid=\"52\">\n          <path d=\"M150,150 Q200,100 250,150 T350,150 T450,200 T550,150 T650,100 T750,150 T850,200\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"80\" stroke-linecap=\"round\" opacity=\"0.5\" data-kid=\"53\"></path>\n          <path d=\"M200,300 Q300,350 400,300 T600,300 T800,350\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"100\" stroke-linecap=\"round\" opacity=\"0.3\" data-kid=\"54\"></path>\n        </svg>\n\n        \n        <div class=\"absolute top-[28%] left-[25%] transition-transform hover:scale-110 duration-300 cursor-help group/pin\" data-kid=\"55\">\n          <div class=\"relative\" data-kid=\"56\">\n            <div class=\"w-4 h-4 bg-[#FF4F00] rounded-full animate-ping absolute inset-0 opacity-40\" data-kid=\"57\"></div>\n            <div class=\"w-4 h-4 bg-[#FF4F00] rounded-full relative z-10 border-[3px] border-white shadow-sm\" data-kid=\"58\"></div>\n            <div class=\"absolute -top-14 left-1/2 -translate-x-1/2 bg-[#111111] text-white px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap shadow-2xl opacity-0 group-hover/pin:opacity-100 transition-opacity translate-y-2 group-hover/pin:translate-y-0 duration-300\" data-kid=\"59\">\n              <i class=\"ti ti-microscope mr-1.5 text-[#FF4F00]\" data-kid=\"60\"></i> Lab Lead, Cambridge\n              <div class=\"absolute top-full left-1/2 -translate-x-1/2 w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-t-[6px] border-t-[#111111]\" data-kid=\"61\"></div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"absolute top-[45%] left-[62%] transition-transform hover:scale-110 duration-300 cursor-help group/pin\" data-kid=\"62\">\n          <div class=\"relative\" data-kid=\"63\">\n            <div class=\"w-4 h-4 bg-[#FF4F00] rounded-full animate-ping absolute inset-0 opacity-40\" data-kid=\"64\"></div>\n            <div class=\"w-4 h-4 bg-[#FF4F00] rounded-full relative z-10 border-[3px] border-white shadow-sm\" data-kid=\"65\"></div>\n            <div class=\"absolute -top-14 left-1/2 -translate-x-1/2 bg-[#111111] text-white px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap shadow-2xl opacity-0 group-hover/pin:opacity-100 transition-opacity translate-y-2 group-hover/pin:translate-y-0 duration-300\" data-kid=\"66\">\n              <i class=\"ti ti-briefcase mr-1.5 text-[#FF4F00]\" data-kid=\"67\"></i> VC Principal, London\n              <div class=\"absolute top-full left-1/2 -translate-x-1/2 w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-t-[6px] border-t-[#111111]\" data-kid=\"68\"></div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"absolute bottom-[30%] left-[50%] transition-transform hover:scale-110 duration-300 cursor-help group/pin\" data-kid=\"69\">\n          <div class=\"relative\" data-kid=\"70\">\n            <div class=\"w-4 h-4 bg-[#FF4F00] rounded-full animate-ping absolute inset-0 opacity-40\" data-kid=\"71\"></div>\n            <div class=\"w-4 h-4 bg-[#FF4F00] rounded-full relative z-10 border-[3px] border-white shadow-sm\" data-kid=\"72\"></div>\n            <div class=\"absolute -top-14 left-1/2 -translate-x-1/2 bg-[#111111] text-white px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap shadow-2xl opacity-0 group-hover/pin:opacity-100 transition-opacity translate-y-2 group-hover/pin:translate-y-0 duration-300\" data-kid=\"73\">\n              <i class=\"ti ti-id mr-1.5 text-[#FF4F00]\" data-kid=\"74\"></i> Tech Founder, Dubai\n              <div class=\"absolute top-full left-1/2 -translate-x-1/2 w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-t-[6px] border-t-[#111111]\" data-kid=\"75\"></div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-8 bg-[#F7F7F7]\" data-kid=\"76\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"77\">\n      <div class=\"text-center mb-20\" data-kid=\"78\">\n        <h2 class=\"text-4xl font-bold font-heading mb-4\" data-kid=\"79\">Command Center</h2>\n        <p class=\"text-lg text-[#111111]/50 max-w-xl mx-auto\" data-kid=\"80\">Everything you need to manage your global trajectory in one crisp interface.</p>\n      </div>\n      \n      <div class=\"grid grid-cols-12 gap-6\" data-kid=\"81\">\n        \n        <div class=\"col-span-12 lg:col-span-8 bg-white hairline-border rounded-[24px] p-10 overflow-hidden flex flex-col\" data-kid=\"82\">\n          <div class=\"flex justify-between items-center mb-10\" data-kid=\"83\">\n            <div data-kid=\"84\">\n              <h3 class=\"text-2xl font-bold font-heading\" data-kid=\"85\">Intelligence Feed</h3>\n              <p class=\"text-sm text-[#111111]/40\" data-kid=\"86\">Real-time matching based on your trajectory</p>\n            </div>\n            <button class=\"text-sm font-semibold text-[#FF4F00] flex items-center gap-1\" data-kid=\"87\">\n              View all <i class=\"ti ti-chevron-right\" data-kid=\"88\"></i>\n            </button>\n          </div>\n          \n          <div class=\"space-y-4 flex-1\" data-kid=\"89\">\n            <div class=\"p-5 hairline-border rounded-2xl flex items-center justify-between hover:bg-white hover:shadow-lg hover:shadow-[#111111]/5 transition-all duration-300 cursor-pointer group\" data-kid=\"90\">\n              <div class=\"flex items-center gap-6\" data-kid=\"91\">\n                <div class=\"w-14 h-14 bg-gray-50 rounded-xl flex items-center justify-center\" data-kid=\"92\">\n                  <i class=\"ti ti-brand-airbnb text-3xl text-[#111111]/20\" data-kid=\"93\"></i>\n                </div>\n                <div data-kid=\"94\">\n                  <h4 class=\"font-bold text-lg group-hover:text-[#FF4F00] transition-colors\" data-kid=\"95\">Lead Product Designer</h4>\n                  <p class=\"text-sm text-[#111111]/50 font-medium tracking-tight\" data-kid=\"96\">Airbnb • San Francisco / Remote</p>\n                </div>\n              </div>\n              <div class=\"text-right\" data-kid=\"97\">\n                <span class=\"inline-block px-3 py-1 bg-[#FF4F00]/5 text-[#FF4F00] text-xs font-bold rounded-full mb-1\" data-kid=\"98\">98% Match</span>\n                <p class=\"text-[10px] text-[#111111]/30 font-bold uppercase tracking-widest\" data-kid=\"99\">Active Now</p>\n              </div>\n            </div>\n\n            <div class=\"p-5 hairline-border rounded-2xl flex items-center justify-between hover:bg-white hover:shadow-lg hover:shadow-[#111111]/5 transition-all duration-300 cursor-pointer group\" data-kid=\"100\">\n              <div class=\"flex items-center gap-6\" data-kid=\"101\">\n                <div class=\"w-14 h-14 bg-gray-50 rounded-xl flex items-center justify-center\" data-kid=\"102\">\n                  <i class=\"ti ti-atom-2 text-3xl text-[#111111]/20\" data-kid=\"103\"></i>\n                </div>\n                <div data-kid=\"104\">\n                  <h4 class=\"font-bold text-lg group-hover:text-[#FF4F00] transition-colors\" data-kid=\"105\">Quantum Computing Fellow</h4>\n                  <p class=\"text-sm text-[#111111]/50 font-medium tracking-tight\" data-kid=\"106\">CERN • Geneva, Switzerland</p>\n                </div>\n              </div>\n              <div class=\"text-right\" data-kid=\"107\">\n                <span class=\"inline-block px-3 py-1 bg-gray-100 text-[#111111]/40 text-xs font-bold rounded-full mb-1\" data-kid=\"108\">92% Match</span>\n                <p class=\"text-[10px] text-[#111111]/30 font-bold uppercase tracking-widest\" data-kid=\"109\">4h ago</p>\n              </div>\n            </div>\n\n            <div class=\"p-5 hairline-border rounded-2xl flex items-center justify-between opacity-40\" data-kid=\"110\">\n              <div class=\"flex items-center gap-6\" data-kid=\"111\">\n                <div class=\"w-14 h-14 bg-gray-50 rounded-xl flex items-center justify-center\" data-kid=\"112\">\n                  <i class=\"ti ti-brand-stripe text-3xl text-[#111111]/20\" data-kid=\"113\"></i>\n                </div>\n                <div data-kid=\"114\">\n                  <h4 class=\"font-bold text-lg\" data-kid=\"115\">Product Strategist</h4>\n                  <p class=\"text-sm text-[#111111]/50\" data-kid=\"116\">Stripe • Remote Europe</p>\n                </div>\n              </div>\n              <div class=\"text-right\" data-kid=\"117\">\n                <span class=\"inline-block px-3 py-1 bg-gray-100 text-[#111111]/40 text-xs font-bold rounded-full mb-1\" data-kid=\"118\">89% Match</span>\n                <p class=\"text-[10px] text-[#111111]/30 font-bold uppercase tracking-widest\" data-kid=\"119\">Yesterday</p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"col-span-12 lg:col-span-4 bg-white hairline-border rounded-[24px] p-10 flex flex-col items-center justify-center text-center\" data-kid=\"120\">\n          <div class=\"relative w-48 h-48 flex items-center justify-center mb-8\" data-kid=\"121\">\n            \n            <div class=\"absolute inset-0 border border-[#111111]/5 rounded-full\" data-kid=\"122\"></div>\n            <div class=\"absolute inset-4 border border-[#111111]/5 rounded-full\" data-kid=\"123\"></div>\n            <div class=\"absolute inset-8 border border-[#111111]/10 rounded-full\" data-kid=\"124\"></div>\n            <div class=\"absolute inset-12 border border-[#FF4F00]/20 rounded-full\" data-kid=\"125\"></div>\n            <div class=\"w-1 h-20 bg-gradient-to-t from-[#FF4F00] to-transparent absolute bottom-1/2 origin-bottom transform rotate-45 animate-[spin_4s_linear_infinite]\" data-kid=\"126\"></div>\n            <div class=\"relative z-10 w-24 h-24 bg-white rounded-full hairline-border flex items-center justify-center shadow-sm\" data-kid=\"127\">\n                <i class=\"ti ti-target-arrow text-4xl text-[#FF4F00]\" data-kid=\"128\"></i>\n            </div>\n          </div>\n          <h3 class=\"text-xl font-bold font-heading mb-3\" data-kid=\"129\">Matching Engine</h3>\n          <p class=\"text-sm text-[#111111]/50 leading-relaxed\" data-kid=\"130\">Multidimensional analysis of your skills, network, and goals.</p>\n        </div>\n\n        \n        <div class=\"col-span-12 lg:col-span-4 bg-white hairline-border rounded-[24px] p-8 flex flex-col hover:shadow-md transition-shadow\" data-kid=\"131\">\n          <h3 class=\"text-lg font-bold font-heading mb-6 flex items-center gap-2\" data-kid=\"132\">\n            <i class=\"ti ti-calendar-event text-[#FF4F00]\" data-kid=\"133\"></i> Auto-Tracking\n          </h3>\n          <div class=\"grid grid-cols-7 gap-2 mb-8 flex-1\" data-kid=\"134\">\n            \n            <div class=\"aspect-square bg-gray-50 rounded-md\" data-kid=\"135\"></div>\n            <div class=\"aspect-square bg-gray-50 rounded-md\" data-kid=\"136\"></div>\n            <div class=\"aspect-square bg-gray-50 rounded-md\" data-kid=\"137\"></div>\n            <div class=\"aspect-square bg-[#FF4F00]/10 rounded-md\" data-kid=\"138\"></div>\n            <div class=\"aspect-square bg-[#FF4F00]/30 rounded-md\" data-kid=\"139\"></div>\n            <div class=\"aspect-square bg-[#FF4F00]/10 rounded-md\" data-kid=\"140\"></div>\n            <div class=\"aspect-square bg-gray-50 rounded-md\" data-kid=\"141\"></div>\n            <div class=\"aspect-square bg-gray-50 rounded-md\" data-kid=\"142\"></div>\n            <div class=\"aspect-square bg-[#FF4F00] rounded-md shadow-sm shadow-[#FF4F00]/40\" data-kid=\"143\"></div>\n            <div class=\"aspect-square bg-gray-50 rounded-md\" data-kid=\"144\"></div>\n            <div class=\"aspect-square bg-gray-50 rounded-md\" data-kid=\"145\"></div>\n            <div class=\"aspect-square bg-gray-100 rounded-md\" data-kid=\"146\"></div>\n            <div class=\"aspect-square bg-gray-100 rounded-md\" data-kid=\"147\"></div>\n            <div class=\"aspect-square bg-gray-50 rounded-md\" data-kid=\"148\"></div>\n            <div class=\"aspect-square bg-gray-50 rounded-md\" data-kid=\"149\"></div>\n            <div class=\"aspect-square bg-gray-50 rounded-md\" data-kid=\"150\"></div>\n            <div class=\"aspect-square bg-gray-50 rounded-md\" data-kid=\"151\"></div>\n            <div class=\"aspect-square bg-gray-50 rounded-md\" data-kid=\"152\"></div>\n            <div class=\"aspect-square bg-gray-50 rounded-md\" data-kid=\"153\"></div>\n            <div class=\"aspect-square bg-[#FF4F00]/20 rounded-md\" data-kid=\"154\"></div>\n            <div class=\"aspect-square bg-gray-50 rounded-md\" data-kid=\"155\"></div>\n          </div>\n          <p class=\"text-xs text-[#111111]/40 font-medium\" data-kid=\"156\">Automatic monitoring of 1,200+ global application portals.</p>\n        </div>\n\n        \n        <div class=\"col-span-12 lg:col-span-8 bg-[#111111] rounded-[24px] p-10 flex items-center justify-between text-white overflow-hidden relative group\" data-kid=\"157\">\n          <div class=\"relative z-10 max-w-sm\" data-kid=\"158\">\n            <span class=\"inline-block px-3 py-1 bg-white/10 text-white/60 text-[10px] font-bold tracking-widest rounded-full mb-4 uppercase\" data-kid=\"159\">Proprietary Insights</span>\n            <h3 class=\"text-2xl font-bold font-heading mb-4\" data-kid=\"160\">Competitive Edge</h3>\n            <p class=\"text-white/60 text-sm leading-relaxed mb-6\" data-kid=\"161\">Access salary benchmarks and institutional hiring trends before they become public knowledge.</p>\n            <button class=\"flex items-center gap-2 text-[#FF4F00] font-bold group\" data-kid=\"162\">\n              Upgrade to Pro <i class=\"ti ti-arrow-up-right group-hover:-translate-y-0.5 group-hover:translate-x-0.5 transition-transform\" data-kid=\"163\"></i>\n            </button>\n          </div>\n          <div class=\"absolute right-0 bottom-0 w-1/2 h-full opacity-30 group-hover:opacity-50 transition-opacity\" data-kid=\"164\">\n            <svg viewBox=\"0 0 400 200\" class=\"w-full h-full\" data-kid=\"165\">\n              <path d=\"M0 180 Q 50 120, 100 150 T 200 80 T 300 40 T 400 20\" fill=\"none\" stroke=\"#FF4F00\" stroke-width=\"4\" stroke-linecap=\"round\" data-kid=\"166\"></path>\n              <path d=\"M0 180 Q 50 120, 100 150 T 200 80 T 300 40 T 400 20 L 400 200 L 0 200 Z\" fill=\"url(#grad)\" data-kid=\"167\"></path>\n              <defs data-kid=\"168\">\n                <linearGradient id=\"grad\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\" data-kid=\"169\">\n                  <stop offset=\"0%\" style=\"stop-color:#FF4F00;stop-opacity:0.2\" data-kid=\"170\"></stop>\n                  <stop offset=\"100%\" style=\"stop-color:#FF4F00;stop-opacity:0\" data-kid=\"171\"></stop>\n                </linearGradient>\n              </defs>\n            </svg>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-8 bg-white\" data-kid=\"172\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"173\">\n      <div class=\"text-center mb-20\" data-kid=\"174\">\n        <h2 class=\"text-4xl font-bold font-heading mb-4\" data-kid=\"175\">Believers & Pioneers</h2>\n        <p class=\"text-lg text-[#111111]/50 max-w-xl mx-auto\" data-kid=\"176\">The trajectories that were permanently shifted by Nexora intelligence.</p>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\" data-kid=\"177\">\n        \n        <div class=\"bg-white p-10 rounded-[32px] simple-elevation flex flex-col justify-between hover:-translate-y-1 transition-transform duration-300\" data-kid=\"178\">\n          <p class=\"text-xl text-[#111111] leading-relaxed mb-12 font-medium\" data-kid=\"179\">\n            \"Nexora found a research fellowship at CERN that hadn't even been advertised on standard job boards. It completely changed my PhD trajectory.\"\n          </p>\n          <div class=\"flex items-center gap-5\" data-kid=\"180\">\n            <img src=\"https://i.pravatar.cc/100?u=anna\" class=\"w-14 h-14 rounded-full border-2 border-[#F7F7F7] shadow-sm\" decoding=\"async\" loading=\"lazy\" data-kid=\"181\">\n            <div data-kid=\"182\">\n              <p class=\"font-bold text-lg\" data-kid=\"183\">Dr. Anna Schmidt</p>\n              <p class=\"text-xs text-[#111111]/40 uppercase tracking-[0.1em] font-bold\" data-kid=\"184\">Research Fellow, Zurich</p>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"bg-white p-10 rounded-[32px] simple-elevation flex flex-col justify-between hover:-translate-y-1 transition-transform duration-300\" data-kid=\"185\">\n          <p class=\"text-xl text-[#111111] leading-relaxed mb-12 font-medium\" data-kid=\"186\">\n            \"The personalized matching engine is uncanny. It surfaced a founding designer role at a stealth startup that was a 100% fit for my background.\"\n          </p>\n          <div class=\"flex items-center gap-5\" data-kid=\"187\">\n            <img src=\"https://i.pravatar.cc/150?u=marcus\" class=\"w-14 h-14 rounded-full border-2 border-[#F7F7F7] shadow-sm\" decoding=\"async\" loading=\"lazy\" data-kid=\"188\">\n            <div data-kid=\"189\">\n              <p class=\"font-bold text-lg\" data-kid=\"190\">Marcus Thorne</p>\n              <p class=\"text-xs text-[#111111]/40 uppercase tracking-[0.1em] font-bold\" data-kid=\"191\">Founding Designer, Stealth</p>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"bg-white p-10 rounded-[32px] simple-elevation flex flex-col justify-between hover:-translate-y-1 transition-transform duration-300\" data-kid=\"192\">\n          <p class=\"text-xl text-[#111111] leading-relaxed mb-12 font-medium\" data-kid=\"193\">\n            \"We use Nexora to identify high-potential talent before they're on the open market. It's our unfair advantage in recruitment.\"\n          </p>\n          <div class=\"flex items-center gap-5\" data-kid=\"194\">\n            <img src=\"https://i.pravatar.cc/150?u=sarah\" class=\"w-14 h-14 rounded-full border-2 border-[#F7F7F7] shadow-sm\" decoding=\"async\" loading=\"lazy\" data-kid=\"195\">\n            <div data-kid=\"196\">\n              <p class=\"font-bold text-lg\" data-kid=\"197\">Sarah Jenkins</p>\n              <p class=\"text-xs text-[#111111]/40 uppercase tracking-[0.1em] font-bold\" data-kid=\"198\">Partner, NorthStar VC</p>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"bg-white p-10 rounded-[32px] simple-elevation flex flex-col justify-between hover:-translate-y-1 transition-transform duration-300\" data-kid=\"199\">\n          <p class=\"text-xl text-[#111111] leading-relaxed mb-12 font-medium\" data-kid=\"200\">\n            \"The global perspective is what makes it unique. It's not just another job board; it's a strategic intelligence platform.\"\n          </p>\n          <div class=\"flex items-center gap-5\" data-kid=\"201\">\n            <img src=\"https://i.pravatar.cc/150?u=liam\" class=\"w-14 h-14 rounded-full border-2 border-[#F7F7F7] shadow-sm\" decoding=\"async\" loading=\"lazy\" data-kid=\"202\">\n            <div data-kid=\"203\">\n              <p class=\"font-bold text-lg\" data-kid=\"204\">Liam Chen</p>\n              <p class=\"text-xs text-[#111111]/40 uppercase tracking-[0.1em] font-bold\" data-kid=\"205\">Growth Lead, Revolut</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"bg-[#F7F7F7] pt-20 px-8 pb-12\" data-kid=\"206\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"207\">\n      \n      <div class=\"bg-[#111111] rounded-[40px] p-16 md:p-24 text-center mb-32 relative overflow-hidden group\" data-kid=\"208\">\n        <div class=\"absolute inset-0 bg-gradient-to-br from-[#FF4F00]/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-1000\" data-kid=\"209\"></div>\n        <div class=\"relative z-10\" data-kid=\"210\">\n          <h2 class=\"text-4xl md:text-6xl font-bold font-heading text-white mb-8 tracking-tighter\" data-kid=\"211\">Ready to redefine<br data-kid=\"212\">your trajectory?</h2>\n          <p class=\"text-white/60 text-lg mb-12 max-w-xl mx-auto\" data-kid=\"213\">Join 50,000+ ambitious professionals discovering their global future on Nexora.</p>\n          <div class=\"flex flex-col sm:flex-row gap-4 justify-center\" data-kid=\"214\">\n            <button class=\"px-10 py-5 bg-[#FF4F00] text-white font-bold rounded-full hover:scale-105 transition-transform shadow-2xl shadow-[#FF4F00]/40\" data-kid=\"215\">\n              Start discovering\n            </button>\n            <button class=\"px-10 py-5 bg-white/10 text-white font-bold rounded-full hover:bg-white/20 transition-all border border-white/10\" data-kid=\"216\">\n              Talk to an advisor\n            </button>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"grid grid-cols-2 md:grid-cols-4 gap-12 mb-20\" data-kid=\"217\">\n        <div class=\"col-span-2 md:col-span-1\" data-kid=\"218\">\n           <div class=\"flex items-center gap-2 mb-6\" data-kid=\"219\">\n            <div class=\"w-6 h-6 bg-[#FF4F00] rounded-sm flex items-center justify-center\" data-kid=\"220\">\n              <span class=\"text-white font-bold text-sm\" data-kid=\"221\">N</span>\n            </div>\n            <span class=\"text-lg font-bold tracking-tight font-heading\" data-kid=\"222\">Nexora</span>\n          </div>\n          <p class=\"text-sm text-[#111111]/40 leading-relaxed max-w-xs\" data-kid=\"223\">\n            The world's first AI-powered intelligence platform for global opportunities.\n          </p>\n        </div>\n        <div data-kid=\"224\">\n          <h4 class=\"font-bold text-sm mb-6 uppercase tracking-widest text-[#111111]/30\" data-kid=\"225\">Platform</h4>\n          <ul class=\"space-y-4 text-sm text-[#111111]/60\" data-kid=\"226\">\n            <li data-kid=\"227\"><a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"228\">Intelligence Feed</a></li>\n            <li data-kid=\"229\"><a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"230\">Global Graph</a></li>\n            <li data-kid=\"231\"><a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"232\">Radar Matching</a></li>\n            <li data-kid=\"233\"><a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"234\">Integrations</a></li>\n          </ul>\n        </div>\n        <div data-kid=\"235\">\n          <h4 class=\"font-bold text-sm mb-6 uppercase tracking-widest text-[#111111]/30\" data-kid=\"236\">Resources</h4>\n          <ul class=\"space-y-4 text-sm text-[#111111]/60\" data-kid=\"237\">\n            <li data-kid=\"238\"><a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"239\">Documentation</a></li>\n            <li data-kid=\"240\"><a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"241\">Case Studies</a></li>\n            <li data-kid=\"242\"><a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"243\">Trajectory Blog</a></li>\n            <li data-kid=\"244\"><a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"245\">Help Center</a></li>\n          </ul>\n        </div>\n        <div data-kid=\"246\">\n          <h4 class=\"font-bold text-sm mb-6 uppercase tracking-widest text-[#111111]/30\" data-kid=\"247\">Legal</h4>\n          <ul class=\"space-y-4 text-sm text-[#111111]/60\" data-kid=\"248\">\n            <li data-kid=\"249\"><a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"250\">Privacy Policy</a></li>\n            <li data-kid=\"251\"><a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"252\">Terms of Service</a></li>\n            <li data-kid=\"253\"><a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"254\">Cookie Policy</a></li>\n            <li data-kid=\"255\"><a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"256\">Security</a></li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"pt-8 border-t border-[#d0d0cc]/50 flex flex-col md:flex-row justify-between items-center gap-4\" data-kid=\"257\">\n        <p class=\"text-[10px] font-bold text-[#111111]/30 uppercase tracking-[0.2em]\" data-kid=\"258\">© 2024 Nexora Intelligence. All rights reserved.</p>\n        <div class=\"flex gap-6 text-[#111111]/40\" data-kid=\"259\">\n          <a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"260\"><i class=\"ti ti-brand-twitter text-lg\" data-kid=\"261\"></i></a>\n          <a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"262\"><i class=\"ti ti-brand-linkedin text-lg\" data-kid=\"263\"></i></a>\n          <a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"264\"><i class=\"ti ti-brand-github text-lg\" data-kid=\"265\"></i></a>\n        </div>\n      </div>\n    </div>\n  </footer>\n</div>\n",
