      "html": "\n<div class=\"bg-[#F8F8F7] min-h-screen font-['Inter',_sans-serif] text-[#0F1014] selection:bg-[#FF4F00]/20 selection:text-[#FF4F00]\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n    \n    .bento-card {\n      background: #FFFFFF;\n      border: 1px solid #E4E4E2;\n      border-radius: 1.25rem;\n      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n    }\n    \n    .bento-card:hover {\n      border-color: #FF4F00;\n      box-shadow: 0 10px 30px -10px rgba(255, 79, 0, 0.05);\n    }\n\n    .dot-pattern {\n      background-image: radial-gradient(#64646B 1px, transparent 1px);\n      background-size: 20px 20px;\n    }\n    \n    .glass-effect {\n      background: rgba(255, 255, 255, 0.8);\n      backdrop-filter: blur(8px);\n    }\n  </style>\n\n  \n  <nav class=\"bg-white border-b border-[#E4E4E2] sticky top-0 z-50\" data-kid=\"2\">\n    <div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\" data-kid=\"3\">\n      <div class=\"flex items-center gap-12\" data-kid=\"4\">\n        <div class=\"flex items-center gap-2 group cursor-pointer\" data-kid=\"5\">\n          <div class=\"w-9 h-9 bg-[#FF4F00] rounded-lg flex items-center justify-center transform group-hover:rotate-6 transition-transform\" data-kid=\"6\">\n            <span class=\"text-white font-bold text-xl leading-none\" data-kid=\"7\">N</span>\n          </div>\n          <span class=\"text-xl font-extrabold tracking-tighter text-[#0F1014]\" data-kid=\"8\">Nexora</span>\n        </div>\n        \n        <div class=\"hidden lg:flex items-center gap-8 text-[13px] font-bold text-[#64646B] uppercase tracking-wider\" data-kid=\"9\">\n          <a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"10\">Opportunities</a>\n          <a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"11\">Scholarships</a>\n          <a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"12\">Resources</a>\n          <a href=\"#\" class=\"hover:text-[#FF4F00] transition-colors\" data-kid=\"13\">Partner Network</a>\n        </div>\n      </div>\n\n      <div class=\"flex items-center gap-4\" data-kid=\"14\">\n        <button class=\"text-sm font-bold text-[#64646B] hover:text-[#0F1014] transition-colors px-4\" data-kid=\"15\">Login</button>\n        <button class=\"bg-[#FF4F00] text-white text-sm font-bold px-7 py-3 rounded-full hover:bg-[#e64600] transition-all shadow-md shadow-[#FF4F00]/10\" data-kid=\"16\">\n          Get Started\n        </button>\n      </div>\n    </div>\n  </nav>\n\n  \n  <section class=\"max-w-7xl mx-auto px-6 pt-20 pb-24\" data-kid=\"17\">\n    <div class=\"flex flex-col lg:flex-row items-center gap-20\" data-kid=\"18\">\n      <div class=\"lg:w-[55%]\" data-kid=\"19\">\n        <div class=\"inline-flex items-center gap-2 px-3 py-1 bg-[#FFF0E5] border border-[#FF4F00]/20 rounded-full mb-8\" data-kid=\"20\">\n          <span class=\"w-2 h-2 bg-[#FF4F00] rounded-full animate-pulse\" data-kid=\"21\"></span>\n          <span class=\"text-[10px] font-bold text-[#FF4F00] uppercase tracking-widest\" data-kid=\"22\">Global Discovery Engine 2.0</span>\n        </div>\n        \n        <h1 class=\"text-[64px] lg:text-[84px] font-extrabold text-[#0F1014] leading-[0.95] tracking-tight mb-8\" data-kid=\"23\">\n          The World's <br data-kid=\"24\"> Opportunity <br data-kid=\"25\">\n          <span class=\"text-[#FF4F00]\" data-kid=\"26\">Intelligence</span>\n        </h1>\n        \n        <p class=\"text-xl text-[#64646B] max-w-xl mb-12 leading-relaxed font-medium\" data-kid=\"27\">\n          The definitive infrastructure for discovering and securing global scholarships, grants, and career breakthroughs.\n        </p>\n        \n        \n        <div class=\"bento-card p-2 max-w-2xl flex items-center shadow-xl shadow-slate-200/50\" data-kid=\"28\">\n          <div class=\"flex-1 flex items-center gap-4 px-6\" data-kid=\"29\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5 text-[#64646B]\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" data-kid=\"30\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" data-kid=\"31\"></path>\n            </svg>\n            <input type=\"text\" placeholder=\"I'm looking for research opportunities in sustainable energy...\" class=\"bg-transparent border-none outline-hidden text-base font-medium w-full py-4 placeholder:text-[#64646B]/50\" data-kid=\"32\">\n          </div>\n          <button class=\"bg-[#0F1014] text-white px-10 py-4 rounded-xl font-bold text-base hover:bg-black transition-all\" data-kid=\"33\">\n            Find\n          </button>\n        </div>\n        \n        <div class=\"mt-8 flex items-center gap-6\" data-kid=\"34\">\n          <span class=\"text-[10px] font-bold text-[#64646B] uppercase tracking-[0.2em]\" data-kid=\"35\">Trending:</span>\n          <div class=\"flex gap-4\" data-kid=\"36\">\n            <a href=\"#\" class=\"text-xs font-bold text-[#0F1014] border-b-2 border-[#FF4F00]/20 hover:border-[#FF4F00] transition-all\" data-kid=\"37\">AI Fellowships</a>\n            <a href=\"#\" class=\"text-xs font-bold text-[#0F1014] border-b-2 border-[#FF4F00]/20 hover:border-[#FF4F00] transition-all\" data-kid=\"38\">Erasmus+</a>\n            <a href=\"#\" class=\"text-xs font-bold text-[#0F1014] border-b-2 border-[#FF4F00]/20 hover:border-[#FF4F00] transition-all\" data-kid=\"39\">Grants</a>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"lg:w-[45%] relative\" data-kid=\"40\">\n        <div class=\"relative z-10 p-4 bg-white rounded-[2.5rem] border border-[#E4E4E2] shadow-2xl rotate-2 hover:rotate-0 transition-transform duration-500\" data-kid=\"41\">\n           <img src=\"https://images.pexels.com/photos/18069814/pexels-