      "html": "<style data-kid=\"0\">\n@import url('https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n.font-head{font-family:'Sora',sans-serif}\n.font-body{font-family:'Inter',sans-serif}\n.font-mono{font-family:'JetBrains Mono',monospace}\n.no-sb::-webkit-scrollbar{display:none}\n.no-sb{-ms-overflow-style:none;scrollbar-width:none}\n.glass{background:rgba(255,255,255,0.85);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}\n@keyframes scrollL{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n@keyframes scrollR{from{transform:translateX(-50%)}to{transform:translateX(0)}}\n.trackL{animation:scrollL 38s linear infinite}\n.trackR{animation:scrollR 42s linear infinite}\n.marq:hover .trackL,.marq:hover .trackR{animation-play-state:paused}\n@keyframes pulseHeart{0%,100%{transform:scale(1)}40%{transform:scale(1.25)}}\n.heart-fill{animation:pulseHeart 1.8s ease-in-out infinite}\n@keyframes floatIn{0%{opacity:0;transform:translateY(8px)}100%{opacity:1;transform:translateY(0)}}\n.toast{animation:floatIn .5s ease both}\n</style>\n\n<div class=\"font-body relative w-full bg-[#f4f6f8] text-[#0f172a] overflow-hidden\" data-kid=\"1\">\n\n  \n  <div class=\"absolute -top-40 -left-40 w-[520px] h-[520px] rounded-full bg-[#FF4F00]/8 blur-3xl pointer-events-none\" data-kid=\"2\"></div>\n  <div class=\"absolute top-[420px] -right-52 w-[560px] h-[560px] rounded-full bg-[#4f46e5]/8 blur-3xl pointer-events-none\" data-kid=\"3\"></div>\n\n  \n  <header class=\"relative z-30 glass border-b border-slate-200/70\" data-kid=\"4\">\n    <div class=\"max-w-[1240px] mx-auto px-8 h-[72px] flex items-center justify-between\" data-kid=\"5\">\n      <div class=\"flex items-center gap-8\" data-kid=\"6\">\n        <div class=\"flex items-center gap-3\" data-kid=\"7\">\n          <div class=\"w-10 h-10 rounded-xl bg-gradient-to-br from-[#FF4F00] to-[#ff7a3c] grid place-items-c