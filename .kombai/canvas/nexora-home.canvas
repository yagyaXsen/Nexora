      "html": "<style data-kid=\"0\">\n@import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap');\n\n.font-head{font-family:'Sora',sans-serif;}\n.font-body{font-family:'Inter',sans-serif;}\n.font-mono{font-family:'JetBrains Mono',monospace;}\n\n.ph-cycle span{position:absolute;left:0;top:0;opacity:0;animation:phc 9s infinite;white-space:nowrap;}\n.ph-cycle span:nth-child(1){animation-delay:0s;}\n.ph-cycle span:nth-child(2){animation-delay:3s;}\n.ph-cycle span:nth-child(3){animation-delay:6s;}\n@keyframes phc{0%{opacity:0;transform:translateY(6px);}4%{opacity:1;transform:translateY(0);}30%{opacity:1;transform:translateY(0);}36%{opacity:0;transform:translateY(-6px);}100%{opacity:0;}}\n\n.cursor-blink{animation:bl 1.1s steps(1) infinite;}\n@keyframes bl{50%{opacity:0;}}\n\n@keyframes scrollL{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}\n@keyframes scrollR{0%{transform:translateX(-50%);}100%{transform:translateX(0);}}\n.tick-l{animation:scrollL 38s linear infinite;}\n.tick-r{animation:scrollR 38s linear infinite;}\n.tick-row:hover .tick-l,.tick-row:hover .tick-r{animation-play-state:paused;}\n\n.no-bar::-webkit-scrollbar{display:none;}\n.no-bar{scrollbar-width:none;}\n\n@keyframes pulseGlow{0%,100%{box-shadow:0 0 0 0 rgba(255,79,0,0.35);}50%{box-shadow:0 0 0 6px rgba(255,79,0,0);}}\n.live-dot{animation:pulseGlow 1.8s ease-out infinite;}\n</style>\n\n<div class=\"font-body w-full bg-[#f4f6f8] text-[#0f172a] pb-20\" data-kid=\"1\">\n\n  \n  <header class=\"w-full border-b border-black/5 bg-white/70 backdrop-blur-xl\" data-kid=\"2\">\n    <div class=\"max-w-[1240px] mx-auto px-8 py-4 flex items-center justify-between\" data-kid=\"3\">\n      <div class=\"flex items-center gap-8\" data-kid=\"4\">\n        <div class=\"flex items-center gap-2.5\" data-kid=\"5\">\n          <div class=\"w-9 h-9 rounded-xl bg-[#0f172a] grid place-items-center font